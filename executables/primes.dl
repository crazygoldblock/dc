i32 main(*u8 args) {    
    for (i32 i = 2;;i += 1;) {
        bool prime = true;
        for (i32 j = 2; j != i; j += 1;) {
            if i % j == 0 {
                prime = false;
                break;
            }
        }
        if prime {
            print_int(i);
        }
    }
    return 0;
}
void print_int(i32 value) {
    *u8 buffer = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 10u8];
    i32 len = 1;
    buffer += 9u64;
    while value != 0 {
        *buffer = ((value % 10) + 48) as u8;
        buffer -= 1u64;
        value /= 10;
        len += 1;
    }
    print(buffer + 1u64, len as u64);
    return;
}